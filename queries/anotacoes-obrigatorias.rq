# CONTRIBUTING.md: toda entidade publicada precisa de rdfs:label (pt-BR) e
# skos:definition. Esta consulta retorna as que estão sem — `robot verify`
# falha o build se ela retornar qualquer linha.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?entidade ?faltando WHERE {
  VALUES ?tipo { owl:Class owl:ObjectProperty owl:DatatypeProperty owl:NamedIndividual }
  ?entidade a ?tipo .
  FILTER(STRSTARTS(STR(?entidade), "https://w3id.org/bfo-br#"))

  {
    FILTER NOT EXISTS { ?entidade rdfs:label ?l }
    BIND("rdfs:label" AS ?faltando)
  } UNION {
    FILTER NOT EXISTS { ?entidade skos:definition ?d }
    BIND("skos:definition" AS ?faltando)
  }
}
ORDER BY ?entidade
