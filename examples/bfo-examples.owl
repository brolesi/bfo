<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY bfo "https://w3id.org/bfo-br#">
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<!--
    Brazilian Financial Ontology (BFO)
    Arquivo de Exemplo - Instâncias
    
    Este arquivo demonstra o uso da ontologia com exemplos práticos
    de entidades, instrumentos e operações financeiras.
-->

<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:bfo="https://w3id.org/bfo-br#">

    <!-- ==========================================
         EXEMPLO 1: INSTITUIÇÃO FINANCEIRA
         ========================================== -->

    <bfo:BancoMultiplo rdf:about="https://example.org/bancos/banco-exemplo">
        <rdfs:label>Banco Exemplo S.A.</rdfs:label>
        <bfo:cnpj>12345678000199</bfo:cnpj>
        <bfo:codigoISPB>12345678</bfo:codigoISPB>
        <bfo:segmentoPrudencial rdf:resource="&bfo;SegmentoS3" />
        <bfo:reguladoPor rdf:resource="&bfo;BancoCentralDoBrasil" />
    </bfo:BancoMultiplo>

    <!-- ==========================================
         EXEMPLO 2: PESSOA FÍSICA (CLIENTE)
         ========================================== -->

    <bfo:PessoaFisica rdf:about="https://example.org/clientes/cliente-001">
        <rdfs:label>João da Silva</rdfs:label>
        <bfo:cpf>12345678901</bfo:cpf>
        <bfo:classificacaoInvestidor rdf:resource="&bfo;InvestidorQualificado" />
    </bfo:PessoaFisica>

    <!-- ==========================================
         EXEMPLO 3: CONTA CORRENTE
         ========================================== -->

    <bfo:ContaCorrente rdf:about="https://example.org/contas/cc-001">
        <rdfs:label>Conta Corrente 12345-6</rdfs:label>
        <bfo:contaMantidaPor rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:chavePIX>joao.silva@email.com</bfo:chavePIX>
    </bfo:ContaCorrente>

    <!-- ==========================================
         EXEMPLO 4: APLICAÇÃO EM CDB
         ========================================== -->

    <!-- O Instrumento -->
    <bfo:CDB rdf:about="https://example.org/instrumentos/cdb-banco-exemplo-2026">
        <rdfs:label>CDB Banco Exemplo 120% CDI</rdfs:label>
        <bfo:codigoISIN>BRBEXECDB001</bfo:codigoISIN>
        <bfo:emitidoPor rdf:resource="https://example.org/bancos/banco-exemplo" />
        <bfo:indexadoPor rdf:resource="&bfo;CDI" />
        <bfo:dataVencimento rdf:datatype="&xsd;dateTime">2027-01-15T00:00:00-03:00</bfo:dataVencimento>
        <bfo:taxaJuros rdf:datatype="&xsd;decimal">1.20</bfo:taxaJuros>
        <rdfs:comment>Taxa: 120% do CDI</rdfs:comment>
        <bfo:coberturaFGC rdf:datatype="&xsd;boolean">true</bfo:coberturaFGC>
    </bfo:CDB>

    <!-- A Operação de Aplicação -->
    <bfo:Aplicacao rdf:about="https://example.org/operacoes/op-001">
        <rdfs:label>Aplicação CDB - João Silva</rdfs:label>
        <bfo:realizadaPor rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:envolveInstrumento
            rdf:resource="https://example.org/instrumentos/cdb-banco-exemplo-2026" />
        <bfo:valorBRL rdf:datatype="&xsd;decimal">50000.00</bfo:valorBRL>
        <bfo:dataOperacao rdf:datatype="&xsd;dateTime">2026-01-15T10:30:00-03:00</bfo:dataOperacao>
        <bfo:dataLiquidacao rdf:datatype="&xsd;dateTime">2026-01-15T00:00:00-03:00</bfo:dataLiquidacao>
        <bfo:incideTributo rdf:resource="&bfo;IR_RendaFixa" />
        <bfo:incideTributo rdf:resource="&bfo;IOF" />
    </bfo:Aplicacao>

    <!-- ==========================================
         EXEMPLO 5: INVESTIMENTO TESOURO DIRETO
         ========================================== -->

    <bfo:TesouroIPCA rdf:about="https://example.org/instrumentos/ntnb-2035">
        <rdfs:label>Tesouro IPCA+ 2035</rdfs:label>
        <bfo:codigoISIN>BRSTNCLTN7A3</bfo:codigoISIN>
        <bfo:indexadoPor rdf:resource="&bfo;IPCA" />
        <bfo:dataVencimento rdf:datatype="&xsd;dateTime">2035-05-15T00:00:00-03:00</bfo:dataVencimento>
        <bfo:taxaJuros rdf:datatype="&xsd;decimal">0.0650</bfo:taxaJuros>
        <rdfs:comment>Taxa: IPCA + 6,50% a.a.</rdfs:comment>
    </bfo:TesouroIPCA>

    <bfo:Aplicacao rdf:about="https://example.org/operacoes/op-002">
        <rdfs:label>Compra Tesouro IPCA+ 2035</rdfs:label>
        <bfo:realizadaPor rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:envolveInstrumento rdf:resource="https://example.org/instrumentos/ntnb-2035" />
        <bfo:valorBRL rdf:datatype="&xsd;decimal">25000.00</bfo:valorBRL>
        <bfo:dataOperacao rdf:datatype="&xsd;dateTime">2026-01-15T14:00:00-03:00</bfo:dataOperacao>
    </bfo:Aplicacao>

    <!-- ==========================================
         EXEMPLO 6: AÇÃO NA B3
         ========================================== -->

    <bfo:AcaoOrdinaria rdf:about="https://example.org/instrumentos/petr3">
        <rdfs:label>Petrobras ON</rdfs:label>
        <bfo:ticker>PETR3</bfo:ticker>
        <bfo:codigoISIN>BRPETRACNOR9</bfo:codigoISIN>
        <bfo:direitoVoto rdf:datatype="&xsd;boolean">true</bfo:direitoVoto>
    </bfo:AcaoOrdinaria>

    <bfo:AcaoPreferencial rdf:about="https://example.org/instrumentos/petr4">
        <rdfs:label>Petrobras PN</rdfs:label>
        <bfo:ticker>PETR4</bfo:ticker>
        <bfo:codigoISIN>BRPETRACNPR6</bfo:codigoISIN>
        <bfo:direitoVoto rdf:datatype="&xsd;boolean">false</bfo:direitoVoto>
        <bfo:preferenciaDistribuicao rdf:datatype="&xsd;boolean">true</bfo:preferenciaDistribuicao>
    </bfo:AcaoPreferencial>

    <!-- ==========================================
         EXEMPLO 7: FUNDO IMOBILIÁRIO
         ========================================== -->

    <bfo:FundoImobiliario rdf:about="https://example.org/instrumentos/xpml11">
        <rdfs:label>XP Malls FII</rdfs:label>
        <bfo:ticker>XPML11</bfo:ticker>
        <bfo:codigoISIN>BRXPMLCTF007</bfo:codigoISIN>
        <bfo:isentoIRPF_Rendimentos rdf:datatype="&xsd;boolean">true</bfo:isentoIRPF_Rendimentos>
        <rdfs:comment>Fundo de shopping centers</rdfs:comment>
    </bfo:FundoImobiliario>

    <!-- ==========================================
         EXEMPLO 8: OPERAÇÃO DE CRÉDITO
         ========================================== -->

    <bfo:CreditoConsignado rdf:about="https://example.org/operacoes/credito-001">
        <rdfs:label>Empréstimo Consignado - Maria Oliveira</rdfs:label>
        <bfo:valorBRL rdf:datatype="&xsd;decimal">30000.00</bfo:valorBRL>
        <bfo:taxaJuros rdf:datatype="&xsd;decimal">0.0180</bfo:taxaJuros>
        <rdfs:comment>Taxa: 1,80% a.m.</rdfs:comment>
        <bfo:classificacaoRisco rdf:resource="&bfo;RiscoA" />
        <bfo:dataOperacao rdf:datatype="&xsd;dateTime">2026-01-10T09:00:00-03:00</bfo:dataOperacao>
    </bfo:CreditoConsignado>

    <!-- Financiamento veicular com garantia de alienação fiduciária -->
    <bfo:AlienacaoFiduciaria rdf:about="https://example.org/garantias/garantia-001">
        <rdfs:label>Alienação Fiduciária - Veículo Placa ABC1D23</rdfs:label>
    </bfo:AlienacaoFiduciaria>

    <bfo:FinanciamentoVeicular rdf:about="https://example.org/operacoes/credito-002">
        <rdfs:label>Financiamento Veicular - João da Silva</rdfs:label>
        <bfo:realizadaPor rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:valorBRL rdf:datatype="&xsd;decimal">80000.00</bfo:valorBRL>
        <bfo:taxaJuros rdf:datatype="&xsd;decimal">0.0135</bfo:taxaJuros>
        <rdfs:comment>Taxa: 1,35% a.m. - 48 parcelas</rdfs:comment>
        <bfo:garantidaPor rdf:resource="https://example.org/garantias/garantia-001" />
        <bfo:classificacaoRisco rdf:resource="&bfo;RiscoA" />
        <bfo:dataOperacao rdf:datatype="&xsd;dateTime">2026-02-03T11:00:00-03:00</bfo:dataOperacao>
    </bfo:FinanciamentoVeicular>

    <!-- ==========================================
         EXEMPLO 9: TRANSAÇÃO PIX
         ========================================== -->

    <bfo:PIX rdf:about="https://example.org/operacoes/pix-001">
        <rdfs:label>PIX para Fornecedor ABC</rdfs:label>
        <bfo:realizadaPor rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:valorBRL rdf:datatype="&xsd;decimal">1500.00</bfo:valorBRL>
        <bfo:dataOperacao rdf:datatype="&xsd;dateTime">2026-01-15T16:45:00-03:00</bfo:dataOperacao>
        <bfo:dataLiquidacao rdf:datatype="&xsd;dateTime">2026-01-15T00:00:00-03:00</bfo:dataLiquidacao>
    </bfo:PIX>

    <!-- ==========================================
         EXEMPLO 10: DEBÊNTURE INCENTIVADA
         ========================================== -->

    <bfo:DebentureIncentivada rdf:about="https://example.org/instrumentos/deb-infra-001">
        <rdfs:label>Debênture Infraestrutura Energia S.A. 2030</rdfs:label>
        <bfo:codigoISIN>BRENERDBS001</bfo:codigoISIN>
        <bfo:indexadoPor rdf:resource="&bfo;IPCA" />
        <bfo:dataVencimento rdf:datatype="&xsd;dateTime">2030-06-15T00:00:00-03:00</bfo:dataVencimento>
        <bfo:taxaJuros rdf:datatype="&xsd;decimal">0.0550</bfo:taxaJuros>
        <rdfs:comment>Taxa: IPCA + 5,50% a.a. - Isento de IR para PF</rdfs:comment>
        <bfo:isentoIRPF rdf:datatype="&xsd;boolean">true</bfo:isentoIRPF>
        <bfo:coberturaFGC rdf:datatype="&xsd;boolean">false</bfo:coberturaFGC>
    </bfo:DebentureIncentivada>

    <!-- ==========================================
         EXEMPLO 11: FUNDO DE INVESTIMENTO (CVM 175)
         ========================================== -->

    <bfo:FundoMultimercado rdf:about="https://example.org/instrumentos/fundo-mm-001">
        <rdfs:label>Fundo Exemplo Multimercado FIC FIM</rdfs:label>
        <bfo:cnpj>23456789000155</bfo:cnpj>
        <bfo:administradoPor rdf:resource="https://example.org/bancos/banco-exemplo" />
        <rdfs:comment>Fundo constituído sob o regime da Resolução CVM 175/2022</rdfs:comment>
    </bfo:FundoMultimercado>

    <!-- ==========================================
         EXEMPLO 12: CONSENTIMENTO OPEN FINANCE
         ========================================== -->

    <bfo:Consentimento rdf:about="https://example.org/consentimentos/consent-001">
        <rdfs:label>Consentimento - Compartilhamento de Dados de Conta</rdfs:label>
        <bfo:consentimentoConcedidoPor rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:consentimentoConcedidoA rdf:resource="https://example.org/bancos/banco-exemplo" />
        <bfo:statusConsentimento rdf:resource="&bfo;ConsentimentoAutorizado" />
        <bfo:dataConsentimento rdf:datatype="&xsd;dateTime">2026-03-01T08:15:00-03:00</bfo:dataConsentimento>
        <bfo:dataExpiracaoConsentimento rdf:datatype="&xsd;dateTime">2027-03-01T08:15:00-03:00</bfo:dataExpiracaoConsentimento>
    </bfo:Consentimento>

    <!-- ==========================================
         EXEMPLO 13: SEGURO (SUSEP)
         ========================================== -->

    <bfo:Seguradora rdf:about="https://example.org/seguradoras/seguradora-exemplo">
        <rdfs:label>Seguradora Exemplo S.A.</rdfs:label>
        <bfo:cnpj>34567890000122</bfo:cnpj>
        <bfo:codigoSUSEP>01234</bfo:codigoSUSEP>
        <bfo:reguladoPor rdf:resource="&bfo;SUSEP" />
    </bfo:Seguradora>

    <bfo:ApoliceDeSeguro rdf:about="https://example.org/apolices/apolice-001">
        <rdfs:label>Apólice de seguro de automóvel</rdfs:label>
        <bfo:numeroApolice>2026-AUTO-000123</bfo:numeroApolice>
        <bfo:apoliceEmitidaPor rdf:resource="https://example.org/seguradoras/seguradora-exemplo" />
        <bfo:seguradoDaApolice rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:dataInicioVigencia rdf:datatype="&xsd;date">2026-04-01</bfo:dataInicioVigencia>
        <bfo:dataFimVigencia rdf:datatype="&xsd;date">2027-03-31</bfo:dataFimVigencia>
    </bfo:ApoliceDeSeguro>

    <bfo:PremioDeSeguro rdf:about="https://example.org/premios/premio-001">
        <rdfs:label>Prêmio anual da apólice 2026-AUTO-000123</rdfs:label>
        <bfo:premioDaApolice rdf:resource="https://example.org/apolices/apolice-001" />
        <bfo:valor rdf:datatype="&xsd;decimal">2400.00</bfo:valor>
        <bfo:moeda rdf:resource="&bfo;BRL" />
    </bfo:PremioDeSeguro>

    <!-- ==========================================
         EXEMPLO 14: CONSORCIO (Lei 11.795/2008)
         ========================================== -->

    <bfo:GrupoDeConsorcio rdf:about="https://example.org/consorcios/grupo-500">
        <rdfs:label>Grupo de consórcio 500 - imóveis</rdfs:label>
        <bfo:grupoAdministradoPor rdf:resource="https://example.org/bancos/banco-exemplo" />
        <bfo:prazoGrupoMeses rdf:datatype="&xsd;integer">180</bfo:prazoGrupoMeses>
        <bfo:taxaAdministracao rdf:datatype="&xsd;decimal">0.18</bfo:taxaAdministracao>
    </bfo:GrupoDeConsorcio>

    <bfo:CotaDeConsorcio rdf:about="https://example.org/consorcios/cota-500-042">
        <rdfs:label>Cota 042 do grupo 500</rdfs:label>
        <bfo:cotaDoGrupo rdf:resource="https://example.org/consorcios/grupo-500" />
        <bfo:cotaTitularizadaPor rdf:resource="https://example.org/clientes/cliente-001" />
    </bfo:CotaDeConsorcio>

    <!-- ==========================================
         EXEMPLO 15: TITULO DE CREDITO (CCB)
         ========================================== -->

    <bfo:CCB rdf:about="https://example.org/titulos/ccb-001">
        <rdfs:label>Cédula de Crédito Bancário 001</rdfs:label>
        <bfo:emitidoPor rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:valor rdf:datatype="&xsd;decimal">50000.00</bfo:valor>
        <bfo:moeda rdf:resource="&bfo;BRL" />
        <bfo:registradoEm rdf:resource="&bfo;SCR" />
        <rdfs:comment>Título executivo da Lei 10.931/2004</rdfs:comment>
    </bfo:CCB>

    <!-- ==========================================
         EXEMPLO 16: EVENTO SOCIETARIO (JCP)
         ========================================== -->

    <bfo:JurosSobreCapitalProprio rdf:about="https://example.org/eventos/jcp-2026-t1">
        <rdfs:label>JCP do primeiro trimestre de 2026</rdfs:label>
        <bfo:eventoSobreInstrumento rdf:resource="https://example.org/instrumentos/acao-exemplo-on" />
        <bfo:dataCom rdf:datatype="&xsd;date">2026-04-15</bfo:dataCom>
        <bfo:dataEx rdf:datatype="&xsd;date">2026-04-16</bfo:dataEx>
        <bfo:incideTributo rdf:resource="&bfo;IR_FonteRendaFixa" />
        <rdfs:comment>Retenção na fonte de 15% conforme a Lei 9.249/1995</rdfs:comment>
    </bfo:JurosSobreCapitalProprio>

    <!-- ==========================================
         EXEMPLO 17: CAMBIO (Lei 14.286/2021)
         ========================================== -->

    <bfo:CambioPronto rdf:about="https://example.org/cambio/contrato-001">
        <rdfs:label>Contrato de câmbio pronto - compra de USD</rdfs:label>
        <bfo:parteDoContrato rdf:resource="https://example.org/clientes/cliente-001" />
        <bfo:moedaEstrangeiraDaOperacao rdf:resource="&bfo;USD" />
        <bfo:taxaCambio rdf:datatype="&xsd;decimal">5.4321</bfo:taxaCambio>
        <bfo:valor rdf:datatype="&xsd;decimal">10000.00</bfo:valor>
        <bfo:moeda rdf:resource="&bfo;USD" />
        <bfo:dataInicioVigencia rdf:datatype="&xsd;date">2026-05-20</bfo:dataInicioVigencia>
        <bfo:prazoLiquidacaoDiasUteis rdf:datatype="&xsd;integer">2</bfo:prazoLiquidacaoDiasUteis>
    </bfo:CambioPronto>

</rdf:RDF>