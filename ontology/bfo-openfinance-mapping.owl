<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY bfo "https://w3id.org/bfo-br#">
    <!ENTITY ofb "https://openfinancebrasil.org.br/schema/">
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<!--
    Brazilian Financial Ontology (BFO)
    Módulo: Mapeamento Open Finance Brasil
    
    Este módulo define os alinhamentos entre a BFO e os schemas
    do Open Finance Brasil (Fase 1-4).
    
    Referência: https://openfinancebrasil.atlassian.net/wiki/spaces/OF/
-->

<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:bfo="https://w3id.org/bfo-br#"
    xmlns:ofb="https://openfinancebrasil.org.br/schema/">

    <owl:Ontology rdf:about="https://w3id.org/bfo-br/mappings/openfinance">
        <rdfs:label xml:lang="pt-BR">BFO - Mapeamento Open Finance Brasil</rdfs:label>
        <dcterms:description xml:lang="pt-BR">Mapeamento semântico entre a Brazilian Financial Ontology e os schemas de dados do Open Finance Brasil.</dcterms:description>
        <owl:imports rdf:resource="https://w3id.org/bfo-br#" />
        <owl:versionInfo>2.1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ==========================================
         FASE 2: DADOS CADASTRAIS E TRANSACIONAIS
         ========================================== -->

    <!-- Consentimento -->
    <owl:Class rdf:about="&ofb;Consent">
        <owl:equivalentClass rdf:resource="&bfo;Consentimento" />
        <rdfs:label xml:lang="en">Consent</rdfs:label>
        <skos:definition xml:lang="pt-BR">Autorização concedida pelo cliente para compartilhamento de seus dados no âmbito do Open Finance.</skos:definition>
    </owl:Class>

    <!-- Clientes -->
    <owl:Class rdf:about="&ofb;NaturalPerson">
        <owl:equivalentClass rdf:resource="&bfo;PessoaFisica" />
        <rdfs:label xml:lang="en">Natural Person</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;BusinessEntity">
        <owl:equivalentClass rdf:resource="&bfo;PessoaJuridica" />
        <rdfs:label xml:lang="en">Business Entity</rdfs:label>
    </owl:Class>

    <!-- Contas -->
    <owl:Class rdf:about="&ofb;Account">
        <owl:equivalentClass rdf:resource="&bfo;Conta" />
        <rdfs:label xml:lang="en">Account</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;CheckingAccount">
        <owl:equivalentClass rdf:resource="&bfo;ContaCorrente" />
        <rdfs:label xml:lang="en">Checking Account</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;SavingsAccount">
        <owl:equivalentClass rdf:resource="&bfo;ContaPoupanca" />
        <rdfs:label xml:lang="en">Savings Account</rdfs:label>
    </owl:Class>

    <!-- Crédito -->
    <owl:Class rdf:about="&ofb;PersonalLoan">
        <owl:equivalentClass rdf:resource="&bfo;EmprestimoPessoal" />
        <rdfs:label xml:lang="en">Personal Loan</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;RealEstateLoan">
        <owl:equivalentClass rdf:resource="&bfo;FinanciamentoImobiliario" />
        <rdfs:label xml:lang="en">Real Estate Loan</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;VehicleLoan">
        <owl:equivalentClass rdf:resource="&bfo;FinanciamentoVeicular" />
        <rdfs:label xml:lang="en">Vehicle Loan</rdfs:label>
    </owl:Class>

    <!-- Cartão de Crédito -->
    <owl:Class rdf:about="&ofb;CreditCardTransaction">
        <owl:equivalentClass rdf:resource="&bfo;OperacaoCartaoCredito" />
        <rdfs:label xml:lang="en">Credit Card Transaction</rdfs:label>
    </owl:Class>

    <!-- ==========================================
         FASE 3: INICIAÇÃO DE PAGAMENTO
         ========================================== -->

    <owl:Class rdf:about="&ofb;PaymentInitiation">
        <rdfs:subClassOf rdf:resource="&bfo;OperacaoPagamento" />
        <rdfs:label xml:lang="en">Payment Initiation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;PIXPayment">
        <rdfs:subClassOf rdf:resource="&bfo;PIX" />
        <rdfs:label xml:lang="en">PIX Payment</rdfs:label>
    </owl:Class>

    <!-- ==========================================
         FASE 4: INVESTIMENTOS
         ========================================== -->

    <owl:Class rdf:about="&ofb;FixedIncomeInvestment">
        <owl:equivalentClass rdf:resource="&bfo;InstrumentoRendaFixa" />
        <rdfs:label xml:lang="en">Fixed Income Investment</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;VariableIncomeInvestment">
        <owl:equivalentClass rdf:resource="&bfo;InstrumentoRendaVariavel" />
        <rdfs:label xml:lang="en">Variable Income Investment</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;TreasuryTitles">
        <owl:equivalentClass rdf:resource="&bfo;TituloPublicoFederal" />
        <rdfs:label xml:lang="en">Treasury Titles</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;InvestmentFund">
        <owl:equivalentClass rdf:resource="&bfo;FundoDeInvestimento" />
        <rdfs:label xml:lang="en">Investment Fund</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="&ofb;BankFixedIncome">
        <rdfs:subClassOf rdf:resource="&bfo;TituloPrivadoRendaFixa" />
        <rdfs:label xml:lang="en">Bank Fixed Income</rdfs:label>
        <skos:definition xml:lang="pt-BR">Produtos de renda fixa emitidos por instituições bancárias (CDB, RDB, LCI, LCA) na API de investimentos do Open Finance.</skos:definition>
    </owl:Class>

    <owl:Class rdf:about="&ofb;CreditFixedIncome">
        <rdfs:subClassOf rdf:resource="&bfo;TituloPrivadoRendaFixa" />
        <rdfs:label xml:lang="en">Credit Fixed Income</rdfs:label>
        <skos:definition xml:lang="pt-BR">Produtos de renda fixa não bancários (debêntures, CRI, CRA) na API de investimentos do Open Finance.</skos:definition>
    </owl:Class>

</rdf:RDF>