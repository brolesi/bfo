        </owl:members>
    </owl:AllDisjointClasses>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;ETF" />
            <rdf:Description rdf:about="&bfo;FundoImobiliario" />
