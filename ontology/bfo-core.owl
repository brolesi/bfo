    <!-- Enumerações fechadas =======================================
         Sem owl:oneOf um valor inventado para segmentoPrudencial ou
         statusConsentimento é aceito silenciosamente. Com ela o
         reasoner acusa. Sem UNA em OWL, o AllDifferent é obrigatório
         para que os indivíduos sejam de fato distintos.
         =========================================================== -->

    <owl:Class rdf:about="&bfo;SegmentacaoPrudencial">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&bfo;SegmentoS1" />
                    <rdf:Description rdf:about="&bfo;SegmentoS2" />
                    <rdf:Description rdf:about="&bfo;SegmentoS3" />
                    <rdf:Description rdf:about="&bfo;SegmentoS4" />
                    <rdf:Description rdf:about="&bfo;SegmentoS5" />
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:AllDifferent>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;SegmentoS1" />
            <rdf:Description rdf:about="&bfo;SegmentoS2" />
            <rdf:Description rdf:about="&bfo;SegmentoS3" />
            <rdf:Description rdf:about="&bfo;SegmentoS4" />
            <rdf:Description rdf:about="&bfo;SegmentoS5" />
        </owl:distinctMembers>
    </owl:AllDifferent>

    <owl:Class rdf:about="&bfo;ClassificacaoInvestidor">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&bfo;InvestidorProfissional" />
                    <rdf:Description rdf:about="&bfo;InvestidorQualificado" />
                    <rdf:Description rdf:about="&bfo;InvestidorVarejo" />
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:AllDifferent>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;InvestidorProfissional" />
            <rdf:Description rdf:about="&bfo;InvestidorQualificado" />
            <rdf:Description rdf:about="&bfo;InvestidorVarejo" />
        </owl:distinctMembers>
    </owl:AllDifferent>

    <owl:Class rdf:about="&bfo;ClassificacaoRiscoCredito">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&bfo;RiscoAA" />
                    <rdf:Description rdf:about="&bfo;RiscoA" />
                    <rdf:Description rdf:about="&bfo;RiscoB" />
                    <rdf:Description rdf:about="&bfo;RiscoC" />
                    <rdf:Description rdf:about="&bfo;RiscoD" />
                    <rdf:Description rdf:about="&bfo;RiscoE" />
                    <rdf:Description rdf:about="&bfo;RiscoF" />
                    <rdf:Description rdf:about="&bfo;RiscoG" />
                    <rdf:Description rdf:about="&bfo;RiscoH" />
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:AllDifferent>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;RiscoAA" />
            <rdf:Description rdf:about="&bfo;RiscoA" />
            <rdf:Description rdf:about="&bfo;RiscoB" />
            <rdf:Description rdf:about="&bfo;RiscoC" />
            <rdf:Description rdf:about="&bfo;RiscoD" />
            <rdf:Description rdf:about="&bfo;RiscoE" />
            <rdf:Description rdf:about="&bfo;RiscoF" />
            <rdf:Description rdf:about="&bfo;RiscoG" />
            <rdf:Description rdf:about="&bfo;RiscoH" />
        </owl:distinctMembers>
    </owl:AllDifferent>

    <owl:Class rdf:about="&bfo;StatusConsentimento">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&bfo;ConsentimentoAguardandoAutorizacao" />
                    <rdf:Description rdf:about="&bfo;ConsentimentoAutorizado" />
                    <rdf:Description rdf:about="&bfo;ConsentimentoRejeitado" />
                    <rdf:Description rdf:about="&bfo;ConsentimentoRevogado" />
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:AllDifferent>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;ConsentimentoAguardandoAutorizacao" />
            <rdf:Description rdf:about="&bfo;ConsentimentoAutorizado" />
            <rdf:Description rdf:about="&bfo;ConsentimentoRejeitado" />
            <rdf:Description rdf:about="&bfo;ConsentimentoRevogado" />
        </owl:distinctMembers>
    </owl:AllDifferent>

    <!-- Identificadores: funcionalidade e chaves ====================
         CPF, CNPJ, ISPB, LEI, COMPE e ISIN são chaves naturais. Sem
         owl:hasKey duas instâncias com o mesmo CNPJ passam como
         entidades distintas e nada as reconcilia.
         =========================================================== -->

    <rdf:Description rdf:about="&bfo;cpf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>
    <rdf:Description rdf:about="&bfo;cnpj">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>
    <rdf:Description rdf:about="&bfo;codigoISPB">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>
    <rdf:Description rdf:about="&bfo;codigoCOMPE">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>
    <rdf:Description rdf:about="&bfo;codigoLEI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>
    <rdf:Description rdf:about="&bfo;codigoISIN">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>
    <rdf:Description rdf:about="&bfo;codigoBCB">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>
    <rdf:Description rdf:about="&bfo;statusConsentimento">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>
    <rdf:Description rdf:about="&bfo;segmentoPrudencial">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty" />
    </rdf:Description>

    <owl:Class rdf:about="&bfo;PessoaFisica">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;cpf" />
        </owl:hasKey>
    </owl:Class>

    <owl:Class rdf:about="&bfo;PessoaJuridica">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;cnpj" />
        </owl:hasKey>
    </owl:Class>

    <owl:Class rdf:about="&bfo;InstituicaoFinanceiraBrasileira">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;codigoISPB" />
        </owl:hasKey>
    </owl:Class>

    <owl:Class rdf:about="&bfo;InstrumentoFinanceiro">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;codigoISIN" />
        </owl:hasKey>
    </owl:Class>

    <owl:Class rdf:about="&bfo;IndicadorEconomico">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="&bfo;codigoBCB" />
        </owl:hasKey>
    </owl:Class>

    <!-- Inversas ===================================================
         Só as que pagam consulta na direção contrária. As demais
         propriedades seguem sem inversa nomeada de propósito.
         =========================================================== -->

    <owl:ObjectProperty rdf:about="&bfo;emite">
        <owl:inverseOf rdf:resource="&bfo;emitidoPor" />
        <rdfs:domain rdf:resource="&bfo;PessoaJuridica" />
        <rdfs:range rdf:resource="&bfo;InstrumentoFinanceiro" />
        <rdfs:label xml:lang="pt-BR">emite</rdfs:label>
        <skos:definition xml:lang="pt-BR">Relaciona a pessoa jurídica ao instrumento financeiro por ela emitido. Inversa de emitidoPor.</skos:definition>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&bfo;regula">
        <owl:inverseOf rdf:resource="&bfo;reguladoPor" />
        <rdfs:domain rdf:resource="&bfo;OrgaoReguladorBrasileiro" />
        <rdfs:range rdf:resource="&bfo;InstituicaoFinanceiraBrasileira" />
        <rdfs:label xml:lang="pt-BR">regula</rdfs:label>
        <skos:definition xml:lang="pt-BR">Relaciona o órgão regulador à instituição financeira sob sua supervisão. Inversa de reguladoPor.</skos:definition>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&bfo;realiza">
        <owl:inverseOf rdf:resource="&bfo;realizadaPor" />
        <rdfs:domain rdf:resource="&bfo;Pessoa" />
        <rdfs:range rdf:resource="&bfo;OperacaoFinanceira" />
        <rdfs:label xml:lang="pt-BR">realiza</rdfs:label>
        <skos:definition xml:lang="pt-BR">Relaciona a pessoa à operação financeira que ela realiza. Inversa de realizadaPor.</skos:definition>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&bfo;custodia">
        <owl:inverseOf rdf:resource="&bfo;custodiadoPor" />
        <rdfs:domain rdf:resource="&bfo;InstituicaoFinanceiraBrasileira" />
        <rdfs:range rdf:resource="&bfo;InstrumentoFinanceiro" />
        <rdfs:label xml:lang="pt-BR">custodia</rdfs:label>
        <skos:definition xml:lang="pt-BR">Relaciona a instituição custodiante ao instrumento financeiro sob sua custódia. Inversa de custodiadoPor.</skos:definition>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&bfo;administra">
        <owl:inverseOf rdf:resource="&bfo;administradoPor" />
        <rdfs:domain rdf:resource="&bfo;InstituicaoFinanceiraBrasileira" />
        <rdfs:range rdf:resource="&bfo;FundoDeInvestimento" />
        <rdfs:label xml:lang="pt-BR">administra</rdfs:label>
        <skos:definition xml:lang="pt-BR">Relaciona o administrador ao fundo de investimento que administra. Inversa de administradoPor.</skos:definition>
    </owl:ObjectProperty>

</rdf:RDF>
